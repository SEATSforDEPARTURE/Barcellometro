# ==========================================
# BARCELLOMETRO ENV CONFIG
# Copy this file to .env and fill values
# ==========================================

# =========================
# CORE CONFIG
# =========================
DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN  # Required: Discord bot token
LOG_LEVEL=INFO
DEFAULT_RETENTION_DAYS=30
IGNORE_BOTS=true
INSTANCE_MODE=worker2
RIASSUNTO_MAX_MINUTES=60
RIASSUNTO_MAX_HOURS=24
RIASSUNTO_MAX_DAYS=30
RIASSUNTO_MAX_WEEKS=4
RIASSUNTO_RANGE_MAX_DAYS=30
NAME_POLICY_TEXT_SHOW_NAMES_ALWAYS=true
NAME_POLICY_VOICE_SHOW_NAMES_FOR_CHAT_MESSAGES=true
NAME_POLICY_VOICE_SHOW_NAMES_FOR_VOICE_TRANSCRIPTS_WHEN_GREEN_ONLY=true
PLUGIN_ALLOWLIST=app.plugins.voice_ingest
ENTITLEMENTS_CONFIG_PATH=settings/entitlements.json
ENTITLEMENTS_CONFIG_RELOAD=false
DEBUG=false

# =========================
# DATABASE
# =========================
DB_PATH=bot.sqlite

# =========================
# DISCORD
# =========================
GUILD_ID=YOUR_GUILD_ID  # Required: Discord server (guild) ID

# =========================
# INSTANCE CONFIG
# =========================
# Worker instances should run only voice ingest responsibilities.

# =========================
# PLUGINS
# =========================
# Worker mode loads only the voice ingest plugin.

# =========================
# STT LOCAL (whisper)
# =========================
STT_LOCAL_MODEL=small
STT_LOCAL_COMPUTE_TYPE=int8
STT_LOCAL_BEAM_SIZE=1

# =========================
# VOICE INGEST (worker)
# =========================
VOICE_INGEST_ENABLED=true  # Enable only on worker instances
VOICE_INGEST_DEFAULT_CHUNK_SECONDS=10
VOICE_INGEST_MIN_CHARS=3
VOICE_INGEST_MAX_QUEUE=50
VOICE_INGEST_MAX_QUEUE_PER_USER=5
VOICE_INGEST_RATE_LIMIT_USER_PER_MIN=6
VOICE_INGEST_MAX_CONCURRENT_STT=1
VOICE_INGEST_STT_TIMEOUT_SEC=60
VOICE_INGEST_CIRCUIT_BREAKER_FAILS=5
VOICE_INGEST_CIRCUIT_BREAKER_COOLDOWN_SEC=120
