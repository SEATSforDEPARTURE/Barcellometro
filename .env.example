DISCORD_TOKEN=
GUILD_ID=
DB_PATH=bot.sqlite
DEFAULT_RETENTION_DAYS=30
IGNORE_BOTS=true
LOG_LEVEL=INFO
OPENAI_API_KEY=
# INSTANCE_MODE=worker1
# PLUGIN_ALLOWLIST=app.plugins.voice_ingest
# INSTANCE_MODE=main
# PLUGIN_ALLOWLIST=app.plugins.discord_adapter,app.plugins.commands,app.plugins.voice_ingest
STT_LOCAL_MODEL=small
STT_LOCAL_COMPUTE_TYPE=int8
STT_LOCAL_BEAM_SIZE=1
# Enable built-in VAD in faster-whisper when supported by installed version.
STT_LOCAL_VAD_FILTER=true
# Conservative decoding for short Discord chunks.
STT_LOCAL_TEMPERATURE=0.0
STT_LOCAL_NO_SPEECH_THRESHOLD=0.65
STT_LOCAL_LOG_PROB_THRESHOLD=-1.0
STT_LOCAL_COMPRESSION_RATIO_THRESHOLD=2.0
AUDIO_NOTES_MAX_MB=25
AUDIO_NOTES_MAX_DURATION_S=180
AUDIO_NOTES_DISCORD_MAX_CHARS=1900
AUDIO_NOTES_QUEUE_MAX=50
VOICE_INGEST_ENABLED=false
VOICE_INGEST_DEFAULT_CHUNK_SECONDS=10
VOICE_INGEST_MIN_CHARS=3
VOICE_INGEST_MAX_QUEUE=50
VOICE_INGEST_MAX_QUEUE_PER_USER=5
VOICE_INGEST_RATE_LIMIT_USER_PER_MIN=6
VOICE_INGEST_MAX_CONCURRENT_STT=1
VOICE_INGEST_STT_TIMEOUT_SEC=60
VOICE_INGEST_CIRCUIT_BREAKER_FAILS=5
VOICE_INGEST_CIRCUIT_BREAKER_COOLDOWN_SEC=120
VOICE_INGEST_MAX_CORRUPTION_RATIO=0.45
VOICE_INGEST_MIN_SPEECH_RATIO=0.20
VOICE_INGEST_MIN_AVG_RMS=250
VOICE_INGEST_MIN_SPOKEN_SECONDS=0.45
VOICE_INGEST_FRAME_SILENCE_RMS=220
VOICE_INGEST_REJECT_HALLUCINATION_TEXTS=true
VOICE_INGEST_DUPLICATE_WINDOW_SEC=120
VOICE_INGEST_DUPLICATE_MAX_REPEATS=3
