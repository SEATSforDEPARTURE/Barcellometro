{
  "docs": {
    "version": 3,
    "purpose": [
      "Fonte ufficiale del copy GREETINGS: narrativa breve a struttura fissa.",
      "Il renderer compone una singola description narrativa (non un elenco) partendo dagli slot del contratto.",
      "Il titolo evento resta separato e usa sempre il formato emoji + __**MAIUSCOLO**__.",
      "Il file mantiene il label evento nel titolo dell'embed e governa solo la grammatica narrativa della description."
    ],
    "narrative_order": [
      "opening",
      "event_phrase",
      "occurrence_phrase",
      "detail_phrase",
      "barcello_phrase (solo leave)",
      "closing_comment"
    ],
    "placeholders": {
      "mention": {
        "description": "Mention Discord completa dell'utente; deve comparire nello slot opening."
      },
      "guild_name": {
        "description": "Nome del server Discord."
      },
      "occurrence_ordinal": {
        "description": "Ordinale evento in formato maiuscolo (es. TERZA)."
      },
      "reason": {
        "description": "Motivo tecnico evento (non va duplicato nella description dei casi moderativi)."
      },
      "duration": {
        "description": "Durata umana (es. 7g, 2h)."
      },
      "inactivity_text": {
        "description": "Dettaglio inattività (es. 30 giorni)."
      },
      "barcello_alert": {
        "description": "Allerta Barcello formattata."
      },
      "barcello_score_text": {
        "description": "Score Barcello formattato (es. 58/100)."
      }
    }
  },
  "mood_default": "accogliente",
  "time_buckets": {
    "night": {
      "start": 0,
      "end": 6
    },
    "morning": {
      "start": 6,
      "end": 12
    },
    "afternoon": {
      "start": 12,
      "end": 18
    },
    "evening": {
      "start": 18,
      "end": 24
    }
  },
  "count_tiers": [
    {
      "min_occurrence": 1,
      "label": "t1"
    },
    {
      "min_occurrence": 2,
      "label": "t2"
    },
    {
      "min_occurrence": 3,
      "label": "t3"
    }
  ],
  "defaults": {
    "fallbacks": {
      "join": {
        "default": [
          "{mention} entra in {guild_name}."
        ]
      },
      "leave": {
        "default": [
          "{mention} lascia {guild_name}."
        ]
      },
      "kick": {
        "default": [
          "{mention} viene allontanato da {guild_name}."
        ]
      },
      "ban": {
        "default": [
          "{mention} è stato bannato da {guild_name}."
        ]
      },
      "tempban": {
        "default": [
          "{mention} è stato escluso temporaneamente da {guild_name} per {duration}."
        ]
      },
      "grace": {
        "default": [
          "{mention} riceve un periodo di grazia su {guild_name} per {duration}."
        ]
      },
      "inactive_kick": {
        "default": [
          "{mention} viene allontanato da {guild_name} per inattività ({inactivity_text})."
        ]
      },
      "inactive_tempban": {
        "default": [
          "{mention} riceve un ban temporaneo per inattività su {guild_name} per {duration} ({inactivity_text})."
        ]
      },
      "inactive_grace": {
        "default": [
          "{mention} riceve un periodo di grazia per inattività su {guild_name} per {duration} ({inactivity_text})."
        ]
      }
    }
  },
  "narrative_contract": {
    "join": {
      "first_occurrence": {
        "opening": "{mention}",
        "event_phrase": "entra in",
        "occurrence_phrase": "{guild_name} per la",
        "detail_phrase": "{occurrence_ordinal} volta",
        "closing_comment": "Benvenut*."
      },
      "repeat": {
        "opening": "{mention}",
        "event_phrase": "torna in",
        "occurrence_phrase": "{guild_name} per la",
        "detail_phrase": "{occurrence_ordinal} volta",
        "closing_comment": "Bentornat*."
      }
    },
    "leave": {
      "opening": "{mention}",
      "event_phrase": "ha lasciato",
      "occurrence_phrase": "{guild_name} per la",
      "detail_phrase": "{occurrence_ordinal} volta",
      "barcello_phrase": "In quel momento il Barcello era {barcello_alert} ({barcello_score_text}).",
      "closing_comment": "Vediamo se tornerà."
    },
    "kick": {
      "opening": "{mention}",
      "event_phrase": "è stato",
      "occurrence_phrase": "allontanato dal server per la",
      "detail_phrase": "{occurrence_ordinal} volta",
      "closing_comment": "Decisione operativa registrata."
    },
    "ban": {
      "opening": "{mention}",
      "event_phrase": "è stato",
      "occurrence_phrase": "bannato dal server per la",
      "detail_phrase": "{occurrence_ordinal} volta",
      "closing_comment": "Che peccato."
    },
    "tempban": {
      "opening": "{mention}",
      "event_phrase": "è stato",
      "occurrence_phrase": "temporaneamente bannato per",
      "detail_phrase": "{duration}",
      "closing_comment": "Provvedimento temporaneo attivo."
    },
    "grace": {
      "opening": "{mention}",
      "event_phrase": "ha ricevuto",
      "occurrence_phrase": "un periodo di grazia di",
      "detail_phrase": "{duration}",
      "closing_comment": "Occasione da non sprecare."
    },
    "inactive_kick": {
      "opening": "{mention}",
      "event_phrase": "è stato",
      "occurrence_phrase": "allontanato per inattività dopo",
      "detail_phrase": "{inactivity_text}",
      "closing_comment": "Timeline aggiornata."
    },
    "inactive_tempban": {
      "opening": "{mention}",
      "event_phrase": "è stato",
      "occurrence_phrase": "temporaneamente bannato per inattività:",
      "detail_phrase": "{duration} ({inactivity_text})",
      "closing_comment": "Rientro possibile alla scadenza."
    },
    "inactive_grace": {
      "opening": "{mention}",
      "event_phrase": "ha ricevuto",
      "occurrence_phrase": "un periodo di grazia per inattività di",
      "detail_phrase": "{duration} ({inactivity_text})",
      "closing_comment": "Ultimo margine disponibile."
    }
  }
}
