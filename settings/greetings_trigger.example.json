{
  "docs": {
    "version": 4,
    "purpose": [
      "Fonte ufficiale del copy GREETINGS: description narrativa con struttura fissa e rigida.",
      "Il renderer compone una sola frase narrativa in corsivo, con mention iniziale e verbi evento in grassetto.",
      "Il titolo evento resta separato e usa il mapping canonico senza conteggi numerici nel titolo.",
      "Il titolo usa sempre il formato emoji + __**MAIUSCOLO**__.",
      "La label evento nel titolo dell'embed è fissa per tipo evento: non distingue prima/successive e non include conteggi."
    ],
    "narrative_order": [
      "opening",
      "action_phrase",
      "occurrence_phrase",
      "detail_phrase",
      "barcello_phrase (solo leave)",
      "closing_comment"
    ],
    "placeholders": {
      "mention": {
        "description": "Mention Discord completa dell'utente."
      },
      "guild_name": {
        "description": "Nome del server Discord."
      },
      "occurrence_number": {
        "description": "Numero occorrenza canonico dell'evento."
      },
      "duration": {
        "description": "Durata umana (es. 7g, 2h)."
      },
      "inactivity_text": {
        "description": "Dettaglio inattività (es. 30 giorni)."
      },
      "barcello_alert": {
        "description": "Allerta Barcello formattata."
      },
      "barcello_score_text": {
        "description": "Score Barcello formattato (es. 58/100)."
      },
      "reason": {
        "description": "Motivo tecnico evento (esposto nel field moderazione quando applicabile)."
      },
      "occurrence_ordinal": {
        "description": "Ordinale evento legacy compatibile (es. TERZA)."
      }
    },
    "narrative_contract": [
      "author standard via pipeline metadata canonica (`attach_author_meta` con `canonical_top_level_command='greetings'`).",
      "titolo dell'embed = label evento canonica finale (`event_label`) in formato `emoji + __**MAIUSCOLO**__`.",
      "la label evento nel titolo dell'embed è fissa per event type e non include conteggio numerico.",
      "description unica narrativa guidata dal JSON (`opening` → `action_phrase` → `occurrence_phrase` → `detail_phrase` → `barcello_phrase` → `closing_comment`).",
      "field separato `Evento` rimosso: l'unico field opzionale è `👇 __**LA MODERAZIONE AGGIUNGE**__` quando applicabile (escluso `inactive_tempban`).",
      "thumbnail dell'embed = avatar utente quando disponibile; footer centralizzato via pipeline.",
      "`barcello_phrase` è consentita solo per `leave`; il commento finale arriva dopo un punto.",
      "i verbi evento sono chiavi semantiche del contratto (`action_phrase`) e non heading strutturali separati."
    ]
  },
  "defaults": {
    "fallbacks": {
      "join": {
        "default": [
          "{mention} torna in {guild_name}."
        ]
      },
      "leave": {
        "default": [
          "{mention} ha lasciato {guild_name}."
        ]
      },
      "kick": {
        "default": [
          "{mention} è stato espulso da {guild_name}."
        ]
      },
      "ban": {
        "default": [
          "{mention} è stato bannato da {guild_name}."
        ]
      },
      "tempban": {
        "default": [
          "{mention} è stato temporaneamente bannato da {guild_name} per {duration}."
        ]
      },
      "grace": {
        "default": [
          "{mention} entra nel periodo di grazia in {guild_name} per {duration}."
        ]
      },
      "inactive_kick": {
        "default": [
          "{mention} è stato espulso da {guild_name} per inattività ({inactivity_text})."
        ]
      },
      "inactive_tempban": {
        "default": [
          "{mention} è stato temporaneamente bannato da {guild_name} per inattività ({duration}, {inactivity_text})."
        ]
      },
      "inactive_grace": {
        "default": [
          "{mention} entra nel periodo di grazia in {guild_name} per inattività ({duration}, {inactivity_text})."
        ]
      },
      "inactive_role_regress": {
        "default": [
          "{mention} è stato retrocesso di ruolo per inattività in {guild_name}."
        ]
      }
    }
  },
  "event_templates": {
    "join": {
      "first_occurrence": {
        "opening": "{mention}",
        "action_phrase": "entra",
        "occurrence_phrase": "in {guild_name} per la",
        "detail_phrase": "{occurrence_number}° volta",
        "closing_comment": [
          "Benvenut*.",
          "Si parte.",
          "Che sia un buon inizio."
        ]
      },
      "repeat": {
        "opening": "{mention}",
        "action_phrase": "torna",
        "occurrence_phrase": "in {guild_name} per la",
        "detail_phrase": "{occurrence_number}° volta",
        "closing_comment": [
          "Bentornat*.",
          "Il server se ne accorge.",
          "Il clima cambia subito."
        ]
      }
    },
    "leave": {
      "opening": "{mention}",
      "action_phrase": "ha lasciato",
      "occurrence_phrase": "{guild_name} per la",
      "detail_phrase": "{occurrence_number}° volta",
      "barcello_phrase": "In quel momento il Barcello era {barcello_alert} ({barcello_score_text})",
      "closing_comment": "Vediamo se tornerà."
    },
    "kick": {
      "opening": "{mention}",
      "action_phrase": "è stato espulso",
      "occurrence_phrase": "da {guild_name} per la",
      "detail_phrase": "{occurrence_number}° volta",
      "closing_comment": [
        "Aria pesante oggi.",
        "Non era proprio il momento migliore.",
        "Il Barcello prende nota."
      ]
    },
    "ban": {
      "opening": "{mention}",
      "action_phrase": "è stato bannato",
      "occurrence_phrase": "da {guild_name} per la",
      "detail_phrase": "{occurrence_number}° volta",
      "closing_comment": [
        "Che peccato.",
        "Il clima si fa strano.",
        "Il server osserva in silenzio."
      ]
    },
    "tempban": {
      "opening": "{mention}",
      "action_phrase": "è stato temporaneamente bannato",
      "occurrence_phrase": "da {guild_name} per",
      "detail_phrase": "{duration}",
      "closing_comment": [
        "Vediamo come evolve.",
        "Chissà se durerà.",
        "L’atmosfera non prometteva benissimo."
      ]
    },
    "grace": {
      "opening": "{mention}",
      "action_phrase": "entra nel periodo di grazia",
      "occurrence_phrase": "in {guild_name} per",
      "detail_phrase": "{duration}",
      "closing_comment": [
        "Ora conta come si muove.",
        "Un margine c’è, va giocato bene.",
        "Il server resta in ascolto."
      ]
    },
    "inactive_kick": {
      "opening": "{mention}",
      "action_phrase": "è stato espulso",
      "occurrence_phrase": "da {guild_name} per inattività dopo",
      "detail_phrase": "{inactivity_text}",
      "closing_comment": [
        "Silenzio lungo, conseguenze reali.",
        "Il tempo fuori pesa.",
        "Si chiude così, per ora."
      ]
    },
    "inactive_tempban": {
      "opening": "{mention}",
      "action_phrase": "è stato temporaneamente bannato",
      "occurrence_phrase": "da {guild_name} per inattività:",
      "detail_phrase": "{duration} ({inactivity_text})",
      "closing_comment": [
        "Il clima resta sospeso.",
        "Non è una porta chiusa, ma quasi.",
        "Si vedrà più avanti."
      ]
    },
    "inactive_grace": {
      "opening": "{mention}",
      "action_phrase": "entra nel periodo di grazia",
      "occurrence_phrase": "in {guild_name} per inattività per",
      "detail_phrase": "{duration} ({inactivity_text})",
      "closing_comment": [
        "È una finestra stretta, ma c’è.",
        "Adesso serve continuità.",
        "Il Barcello osserva i prossimi passi."
      ]
    },
    "inactive_role_regress": {
      "opening": "{mention}",
      "action_phrase": "è stato retrocesso di ruolo",
      "occurrence_phrase": "in {guild_name} per inattività.",
      "detail_phrase": "",
      "closing_comment": [
        "Si riparte dal nuovo livello.",
        "Un passaggio netto, ora conta la continuità.",
        "Nuovo ruolo, nuova fase."
      ]
    }
  },
  "moods": {
    "teso": {
      "event_templates": {
        "ban": {
          "closing_comment": [
            "Aria pesante oggi.",
            "Il clima non perdona."
          ]
        },
        "tempban": {
          "closing_comment": [
            "Il clima resta teso.",
            "La stanza trattiene il fiato."
          ]
        }
      }
    },
    "accogliente": {
      "event_templates": {
        "join": {
          "first_occurrence": {
            "closing_comment": [
              "Benvenut*.",
              "Che bello vederti qui."
            ]
          },
          "repeat": {
            "closing_comment": [
              "Bentornat*.",
              "Si respira meglio con questo rientro."
            ]
          }
        }
      }
    }
  }
}
