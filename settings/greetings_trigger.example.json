{
  "mood_default": "accogliente",
  "time_buckets": {
    "night": { "start": 0, "end": 6 },
    "morning": { "start": 6, "end": 12 },
    "afternoon": { "start": 12, "end": 18 },
    "evening": { "start": 18, "end": 24 }
  },
  "count_tiers": [
    { "min_occurrence": 1, "label": "t1" },
    { "min_occurrence": 2, "label": "t2" },
    { "min_occurrence": 3, "label": "t3" }
  ],
  "templates": {
    "join": [
      "{mention} entra in {server}."
    ],
    "leave": [
      "{mention} ha lasciato {server}.",
      "{mention} si allontana da {server}."
    ],
    "kick": [
      "{mention} è stato allontanato da {server}{reason_suffix}."
    ],
    "ban": [
      "{mention} è stato bannato da {server}{reason_suffix}."
    ],
    "tempban": [
      "{mention} è stato escluso temporaneamente da {server} per {duration}{reason_suffix}."
    ],
    "grace": [
      "{mention} riceve un periodo di grazia nel server {server} per {duration}."
    ],
    "inactive_kick": [
      "{mention} viene allontanato da {server} per inattività ({inactivity_text})."
    ],
    "inactive_tempban": [
      "{mention} riceve un ban temporaneo per inattività in {server} per {duration} ({inactivity_text})."
    ],
    "inactive_grace": [
      "{mention} entra in periodo di grazia per inattività su {server} per {duration} ({inactivity_text})."
    ]
  },
  "moods": {
    "accogliente": {
      "time": {
        "morning": {
          "templates": {
            "join": [
              "Buongiorno {mention}, benvenuto su {server}."
            ]
          }
        },
        "evening": {
          "templates": {
            "leave": [
              "{mention} chiude la giornata e lascia {server}."
            ]
          }
        }
      },
      "barcello": {
        "verde": {
          "templates": {
            "join": [
              "{mention}, benvenuto su {server}. {barcello_alert}, cuore del server su **{barcello_score_text}**."
            ]
          }
        }
      },
      "count": {
        "t1": {
          "templates": {
            "join": [
              "{mention}, benvenuto su {server}."
            ]
          }
        },
        "t2": {
          "templates": {
            "join": [
              "{mention} torna su {server}."
            ]
          }
        },
        "t3": {
          "templates": {
            "join": [
              "{mention} rientra di nuovo su {server}."
            ]
          }
        }
      }
    },
    "teso": {
      "barcello": {
        "rosso": {
          "templates": {
            "kick": [
              "Clima già delicato: {mention} viene allontanato da {server}{reason_suffix}. {barcello_alert}."
            ],
            "ban": [
              "Con barcello rosso, {mention} riceve un ban da {server}{reason_suffix}. {barcello_alert}."
            ]
          }
        },
        "nero": {
          "templates": {
            "inactive_tempban": [
              "Nel pieno dell'allerta nera, {mention} riceve un ban temporaneo per inattività in {server}. {barcello_alert}."
            ]
          }
        }
      },
      "count": {
        "t1": {
          "templates": {
            "join": [
              "{mention}, benvenuto in {server}. Il clima resta da osservare."
            ]
          }
        },
        "t2": {
          "templates": {
            "join": [
              "{mention} torna in {server}, ma il clima resta teso."
            ],
            "leave": [
              "È già la seconda uscita: {mention} si allontana di nuovo da {server}."
            ]
          }
        }
      }
    }
  }
}
