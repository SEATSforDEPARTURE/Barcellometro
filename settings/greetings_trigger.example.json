{
  "docs": {
    "version": 3,
    "purpose": [
      "Source of truth del copy GREETINGS con struttura fissa e render UI deterministico.",
      "Questo file governa description blocks, commenti finali e field opzionali; non il layout tecnico author/footer.",
      "La mention apre sempre la description; il renderer applica sempre corsivo globale e placeholder principali in grassetto."
    ],
    "event_type_keys": {
      "join": "Ingresso utente.",
      "leave": "Uscita volontaria.",
      "kick": "Allontanamento moderazione.",
      "ban": "Ban moderazione.",
      "tempban": "Ban temporaneo moderazione.",
      "grace": "Periodo di grazia moderazione.",
      "inactive_kick": "Allontanamento per inattività.",
      "inactive_tempban": "Ban temporaneo per inattività.",
      "inactive_grace": "Periodo di grazia per inattività."
    },
    "description_contract": {
      "order": [
        "mention",
        "event",
        "occurrence",
        "details",
        "leave_barcello (solo leave)",
        "extra",
        "bot_comment"
      ],
      "notes": [
        "Nessuna emoji in apertura description.",
        "Le sezioni strutturali importanti devono essere field Discord reali.",
        "Il blocco moderazione è gestito come field finale dal renderer."
      ]
    },
    "placeholders": {
      "mention": {"description": "Mention utente."},
      "display_name": {"description": "Display name utente."},
      "guild_name": {"description": "Nome server."},
      "event_label_text": {"description": "Etichetta evento senza emoji e ordinale."},
      "occurrence_number": {"description": "Occorrenza evento per utente."},
      "duration": {"description": "Durata umana (es. 7g)."},
      "inactivity_text": {"description": "Sintesi inattività."},
      "barcello_alert": {"description": "Allerta Barcello già pronta."},
      "barcello_score_text": {"description": "Indice Barcello formattato."}
    }
  },
  "mood_default": "accogliente",
  "time_buckets": {
    "night": {"start": 0, "end": 6},
    "morning": {"start": 6, "end": 12},
    "afternoon": {"start": 12, "end": 18},
    "evening": {"start": 18, "end": 24}
  },
  "count_tiers": [
    {"min_occurrence": 1, "label": "t1"},
    {"min_occurrence": 2, "label": "t2"},
    {"min_occurrence": 3, "label": "t3"}
  ],
  "event_copy": {
    "join": {
      "description_blocks": {
        "event": "{event_label_text}: ingresso registrato su {guild_name}.",
        "occurrence": "Occorrenza {occurrence_number} per {display_name}.",
        "details": "Dettaglio evento: membro ora presente nel server.",
        "bot_comment": "Benvenut* e buona permanenza."
      }
    },
    "leave": {
      "description_blocks": {
        "event": "{event_label_text}: uscita volontaria registrata su {guild_name}.",
        "occurrence": "Occorrenza {occurrence_number} per {display_name}.",
        "details": "Dettaglio evento: uscita spontanea dal server.",
        "leave_barcello": "Barcello al momento dell'uscita: {barcello_alert} con indice {barcello_score_text}.",
        "bot_comment": "Se desidera rientrare, il server resta raggiungibile."
      }
    },
    "kick": {
      "description_blocks": {
        "event": "{event_label_text}: allontanamento registrato su {guild_name}.",
        "occurrence": "Occorrenza {occurrence_number} per {display_name}.",
        "details": "Dettaglio evento: intervento di moderazione eseguito."
      }
    },
    "ban": {
      "description_blocks": {
        "event": "{event_label_text}: ban registrato su {guild_name}.",
        "occurrence": "Occorrenza {occurrence_number} per {display_name}.",
        "details": "Dettaglio evento: accesso revocato."
      }
    },
    "tempban": {
      "description_blocks": {
        "event": "{event_label_text}: ban temporaneo registrato su {guild_name}.",
        "occurrence": "Occorrenza {occurrence_number} per {display_name}.",
        "details": "Durata prevista: {duration}."
      }
    },
    "grace": {
      "description_blocks": {
        "event": "{event_label_text}: periodo di grazia registrato su {guild_name}.",
        "occurrence": "Occorrenza {occurrence_number} per {display_name}.",
        "details": "Durata prevista: {duration}."
      }
    },
    "inactive_kick": {
      "description_blocks": {
        "event": "{event_label_text}: allontanamento per inattività su {guild_name}.",
        "occurrence": "Occorrenza {occurrence_number} per {display_name}.",
        "details": "Soglia inattività rilevata: {inactivity_text}."
      }
    },
    "inactive_tempban": {
      "description_blocks": {
        "event": "{event_label_text}: ban temporaneo per inattività su {guild_name}.",
        "occurrence": "Occorrenza {occurrence_number} per {display_name}.",
        "details": "Durata {duration} con inattività {inactivity_text}."
      }
    },
    "inactive_grace": {
      "description_blocks": {
        "event": "{event_label_text}: grazia per inattività registrata su {guild_name}.",
        "occurrence": "Occorrenza {occurrence_number} per {display_name}.",
        "details": "Finestra di grazia: {duration} ({inactivity_text})."
      }
    }
  },
  "defaults": {
    "fallbacks": {
      "join": {"default": ["{mention} ingresso su {guild_name}."]},
      "leave": {"default": ["{mention} uscita da {guild_name}."]},
      "kick": {"default": ["{mention} allontanato da {guild_name}{reason_suffix}."]},
      "ban": {"default": ["{mention} bannato da {guild_name}{reason_suffix}."]},
      "tempban": {"default": ["{mention} ban temporaneo su {guild_name} per {duration}{reason_suffix}."]},
      "grace": {"default": ["{mention} in grazia su {guild_name} per {duration}."]},
      "inactive_kick": {"default": ["{mention} allontanato per inattività ({inactivity_text})."]},
      "inactive_tempban": {"default": ["{mention} ban temporaneo per inattività su {guild_name} per {duration} ({inactivity_text})."]},
      "inactive_grace": {"default": ["{mention} grazia per inattività su {guild_name} per {duration} ({inactivity_text})."]}
    }
  },
  "templates": {
    "join": {"default": ["{mention} ingresso su {guild_name}."]},
    "leave": {"default": ["{mention} uscita da {guild_name}."]},
    "kick": ["{mention} allontanato da {guild_name}{reason_suffix}."],
    "ban": ["{mention} bannato da {guild_name}{reason_suffix}."],
    "tempban": ["{mention} ban temporaneo su {guild_name} per {duration}{reason_suffix}."],
    "grace": ["{mention} grazia su {guild_name} per {duration}."],
    "inactive_kick": ["{mention} allontanato per inattività ({inactivity_text})."],
    "inactive_tempban": ["{mention} ban temporaneo per inattività su {guild_name} per {duration} ({inactivity_text})."],
    "inactive_grace": ["{mention} grazia per inattività su {guild_name} per {duration} ({inactivity_text})."]
  },
  "moods": {}
}
